{
  "name": "cloudflare-edge-locations",
  "version": "0.1.9",
  "description": "List of cloudflare.com edge locations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "mocha --require ts-node/register test/tests.ts",
    "install-duckdb": "./scripts/install-duckdb.sh",
    "download": "rm -rf temp/ && mkdir -p temp && duckdb < scripts/load-airports.sql",
    "generate": "mkdir -p data && ts-node --transpile-only generate.ts",
    "bundle": "rm -rf dist/ src/data/ && mkdir -p src/data && cp data/*.json src/data && tsc --build src/",
    "build": "npm run airports:download && npm run airports:filter && npm run countries:download && npm run generate && npm run bundle",
    "prepack": "npm run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/cloudflare-edge-locations.git"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "keywords": [
    "cloudflare",
    "edge",
    "location",
    "codes",
    "lookup"
  ],
  "author": {
    "name": "TobiLG",
    "email": "tobilg@gmail.com",
    "url": "https://github.com/tobilg"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tobilg/cloudflare-edge-locations/issues"
  },
  "homepage": "https://github.com/tobilg/cloudflare-edge-locations#readme",
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.7.0",
    "@types/utf8": "^3.0.3",
    "chai": "^5.1.1",
    "mocha": "^10.7.3",
    "puppeteer": "^23.5.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "utf8": "^3.0.0"
  }
}
